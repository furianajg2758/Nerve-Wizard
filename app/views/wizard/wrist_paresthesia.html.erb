<div>
<% content_for :affected_areas do %><%= @concern.affected_areas&.titleize %><% end %>
</div>

<div class="wizard-step">

  <%= render "wizard/paresthesia" %>

  <%= form_with model: @concern,
                url: wizard_path(step),
                method: :patch,
                local: true,
                authenticity_token: true,
                data: { turbo: false } do |f| %>

    <!-- Keep affected_area transported across steps -->
    <%= hidden_field_tag "concern[affected_areas]", @concern.affected_areas %>

    <div class="list-group mb-4">

      <% paresthesia_options = [
        "posterior elbow",
        "lateral elbow",
        "anterior forearm",
        "posterior forearm",
        "lateral forearm",
        "posterior wrist",
        "lateral wrist",
        "medial wrist",
        "medial hand",
        "thumb",
        "index finger",
        "middle finger",
        "ring finger",
        "little finger"
      ] %>

      <% paresthesia_options.each do |area| %>
        <label class="list-group-item">
          <%= check_box_tag "concern[paresthesia][]",
                            area,
                            @concern.paresthesia.include?(area),
                            class: "form-check-input me-1 paresthesia-checkbox" %>
          <%= area.titleize %>
        </label>
      <% end %>

      <!-- None option -->
      <label class="list-group-item list-group-item-light mt-3">
        <%= check_box_tag "concern[paresthesia][]",
                          "none",
                          (@concern.paresthesia == ["none"]),
                          class: "form-check-input me-1 none-checkbox" %>
        None
      </label>

    </div>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center">
      <%= link_to "Back", previous_wizard_path, class: "btn btn-outline-secondary" %>
      <%= link_to "Start Over", restart_path, class: "btn btn-outline-secondary" %>
      <%= f.submit "Continue", class: "btn btn-primary" %>
    </div>

  <% end %>
</div>


<!-- JS: Mutually exclusive "None" logic -->
<script>
document.addEventListener("DOMContentLoaded", function() {

  const noneBox = document.querySelector(".none-checkbox");
  const sensoryBoxes = document.querySelectorAll(".paresthesia-checkbox");

  // Selecting "None" clears all other paresthesia boxes
  if (noneBox) {
    noneBox.addEventListener("change", function() {
      if (this.checked) {
        sensoryBoxes.forEach(cb => cb.checked = false);
      }
    });
  }

  // Selecting any location clears "None"
  sensoryBoxes.forEach(cb => {
    cb.addEventListener("change", function() {
      if (this.checked) {
        noneBox.checked = false;
      }
    });
  });

});
</script>
