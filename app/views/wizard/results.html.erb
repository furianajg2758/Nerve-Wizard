<div class="results-container">
  <h2 class="mb-4">Potential Nerve Involvement</h2>

  <% if @matches.any? %>
    <%# 1. Logic to split the matches %>
    <% 
      top_score = @matches.first[:score]
      best_matches = @matches.select { |m| m[:score] == top_score }
      other_matches = @matches.reject { |m| m[:score] == top_score }.first(3)
    %>

    <%# --- BEST MATCH SECTION --- %>
    <section class="mb-5">
      <div class="alert alert-success border-0 shadow-sm mb-4">
        <h4 class="alert-heading fw-bold mb-1">Best Match</h4>
        <p class="mb-0">This <%= best_matches.count > 1 ? "group of nerves matches" : "nerve matches" %> your symptoms most closely.</p>
      </div>

      <% best_matches.each do |result| %>
        <%= render "nerve_result_card", result: result, border_class: "border-primary shadow" %>
      <% end %>
    </section>

    <%# --- NEXT BEST MATCHES SECTION --- %>
    <% if other_matches.any? %>
      <section>
        <h5 class="text-muted mb-3">Next Best Matches</h5>
        <% other_matches.each do |result| %>
          <%= render "nerve_result_card", result: result, border_class: "border-light opacity-75" %>
        <% end %>
      </section>
    <% end %>

  <% else %>
    <%# ... your existing No Matches block ... %>
  <% end %>

  <div class="mt-5 text-center">
    <%= link_to "Start Over", restart_path, class: "btn btn-outline-secondary px-4" %>
  </div>
</div>