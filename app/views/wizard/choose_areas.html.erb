<h2>What is the main area of complaint?</h2>

<%= form_with model: @concern,
              url: wizard_path(step),
              method: :put,
              data: {turbo: false },
              local: true,
              authenticity_token: true do |f| %>


<%= f.select :affected_areas, [['Shoulder', 'shoulder'], ['Upper arm', 'arm'], ['Elbow', 'elbow'], ['Forearm', 'forearm'], ['Wrist', 'wrist'], ['Hand', 'hand'], ['Thigh', 'thigh'], ['Knee', 'knee'], ['Lower leg', 'lower leg'], ['Ankle', 'ankle'], ['Foot', 'foot']] %>
  <%= f.submit "Next Step" %>
<% end %>
