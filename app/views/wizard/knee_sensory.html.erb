<div>
  <% content_for(:affected_areas) { @concern.affected_areas&.titleize } %>
</div>

<div class="wizard-container">
  <%= render "wizard/sensory_loss" %>

  <%= form_with model: @concern,
                url: wizard_path(step),
                method: :patch,
                local: true,
                authenticity_token: true,
                data: { turbo: false } do |f| %>

    <!-- Keep affected_area transported across steps -->
    <%= hidden_field_tag "concern[affected_areas]", @concern.affected_areas %>

    <div class="list-group mb-4">

      <% sensory_options = [
        "back",
        "upper buttock",
        "medial buttock",
        "anterior thigh",
        "posterior thigh",
        "lateral thigh",
        "anterior knee",
        "posterior knee",
        "lateral knee",
        "anterior lower leg",
        "posterior lower leg",
        "lateral lower leg",
        "medial lower leg",
        "dorsum of foot",
        "posteromedial foot",
        "medial sole of foot",
        "big toe",
        "second toe",
        "third toe"
      ] %>

      <% sensory_options.each do |area| %>
        <label class="list-group-item">
          <%= check_box_tag "concern[sensory][]",
                            area,
                            @concern.sensory.include?(area),
                            class: "form-check-input me-1 sensory-checkbox" %>
          <%= area.titleize %>
        </label>
      <% end %>

      <!-- None option -->
      <label class="list-group-item list-group-item-light mt-3">
        <%= check_box_tag "concern[sensory][]",
                          "none",
                          (@concern.sensory == ["none"]),
                          class: "form-check-input me-1 none-checkbox" %>
        None
      </label>

    </div>

    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center">
      <%= link_to "Back", previous_wizard_path, class: "btn btn-outline-secondary" %>
      <%= link_to "Start Over", restart_path, class: "btn btn-outline-secondary" %>
      <%= f.submit "Continue", class: "btn btn-primary" %>
    </div>

  <% end %>
</div>


<!-- JS: Mutually exclusive "None" logic -->
<script>
document.addEventListener("DOMContentLoaded", function() {

  const noneBox = document.querySelector(".none-checkbox");
  const sensoryBoxes = document.querySelectorAll(".sensory-checkbox");

  // Selecting "None" clears all other sensory boxes
  if (noneBox) {
    noneBox.addEventListener("change", function() {
      if (this.checked) {
        sensoryBoxes.forEach(cb => cb.checked = false);
      }
    });
  }

  // Selecting any location clears "None"
  sensoryBoxes.forEach(cb => {
    cb.addEventListener("change", function() {
      if (this.checked) {
        noneBox.checked = false;
      }
    });
  });

});
</script>
