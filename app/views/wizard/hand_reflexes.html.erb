<div>
  <% content_for(:affected_areas) { @concern.affected_areas&.titleize } %>
</div>

  <%= render "wizard/reflexes" %>

<% 
  groups = { 
    "Upper limb" => ["biceps brachii", "brachioradialis", "triceps"]
  } 
%>

<%= render layout: 'step_frame', locals: { field_name: 'reflexes' } do %>
  <% groups.each do |group_name, areas| %>
    <div class="list-group-item bg-light text-muted fw-bold small text-uppercase py-2">
      <%= group_name %>
    </div>
    <% areas.each do |area| %>
      <label class="list-group-item list-group-item-action d-flex align-items-center py-3 ps-4" for="check_<%= area.parameterize %>">
        <%= check_box_tag "concern[reflexes][]", area, @concern.reflexes.include?(area),
            class: "form-check-input me-3 reflexes-checkbox", id: "check_#{area.parameterize}" %>
        <span><%= area.titleize %></span>
      </label>
    <% end %>
  <% end %>
<% end %>