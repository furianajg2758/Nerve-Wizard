<% 
  is_start = (step.to_s == "choose_areas")
  is_results = (step.to_s == "results")
  
  display_total = is_start ? 6 : wizard_steps.count
  current_index = wizard_steps.index(step).to_i + 1
%>

<div class="container mt-4 mb-3">
  <% if is_results %>
    <div class="text-center py-4 border-bottom mb-4">
      <h1 class="h4 text-primary fw-bold mb-0">Nerve Wizard</h1>
      <span class="text-success small text-uppercase ls-wide mt-2 d-block">Analysis Complete</span>
    </div>
  <% else %>
    <div class="row">
      <div class="col-12">
        <%# TOP ROW: App Name on left, Step info on right %>
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-primary fw-bold" style="letter-spacing: -0.02rem;">
            Nerve Wizard
          </span>
          <span class="text-muted small text-uppercase fw-bold ls-wide" style="font-size: 0.7rem;">
            Step <%= current_index %> of <%= display_total %>
          </span>
        </div>
      </div>
    </div>
  <% end %>
</div>