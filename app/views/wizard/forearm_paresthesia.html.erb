<div>
  <% content_for(:affected_areas) { @concern.affected_areas&.titleize } %>
</div>

  <%= render "wizard/paresthesia" %>

<% 
  groups = {
    "Forearm" => ["anterior forearm", "posterior forearm", "lateral forearm", "medial forearm"],
    "Fingers" => ["thumb", "index finger", "middle finger", "ring finger", "little finger"],
  } 
%>

<%= render layout: 'step_frame', locals: { field_name: 'paresthesia' } do %>
  <% groups.each do |group_name, areas| %>
    <div class="list-group-item bg-light text-muted fw-bold small text-uppercase py-2">
      <%= group_name %>
    </div>
    <% areas.each do |area| %>
      <label class="list-group-item list-group-item-action d-flex align-items-center py-3 ps-4" for="check_<%= area.parameterize %>">
        <%= check_box_tag "concern[paresthesia][]", area, @concern.paresthesia.include?(area),
            class: "form-check-input me-3 paresthesia-checkbox", id: "check_#{area.parameterize}" %>
        <span><%= area.titleize %></span>
      </label>
    <% end %>
  <% end %>
<% end %>