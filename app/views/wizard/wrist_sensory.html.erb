<div>
  <% content_for(:affected_areas) { @concern.affected_areas&.titleize } %>
</div>

  <%= render "wizard/sensory_loss" %>

<% 
  groups = {
    "Shoulder" => ["lateral shoulder"],
    "Upper arm" => ["anterior upper arm", "posterior upper arm", "lateral upper arm", "medial upper arm"],
    "Elbow" => ["posterior elbow", "lateral elbow", "medial elbow"],
    "Forearm" => ["anterior forearm", "posterior forearm", "lateral forearm", "medial forearm"],
    "Wrist" => ["anterior wrist", "posterior wrist", "lateral wrist", "medial wrist"],
    "Hand" => ["radial hand", "medial hand"],
    "Fingers" => ["thumb", "index finger", "middle finger", "ring finger", "little finger"]
  } 
%>

<%= render layout: 'step_frame', locals: { field_name: 'sensory' } do %>
  <% groups.each do |group_name, areas| %>
    <div class="list-group-item bg-light text-muted fw-bold small text-uppercase py-2">
      <%= group_name %>
    </div>
    <% areas.each do |area| %>
      <label class="list-group-item list-group-item-action d-flex align-items-center py-3 ps-4" for="check_<%= area.parameterize %>">
        <%= check_box_tag "concern[sensory][]", area, @concern.sensory.include?(area),
            class: "form-check-input me-3 sensory-checkbox", id: "check_#{area.parameterize}" %>
        <span><%= area.titleize %></span>
      </label>
    <% end %>
  <% end %>
<% end %>