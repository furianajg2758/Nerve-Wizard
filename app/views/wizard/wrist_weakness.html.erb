<div>
  <% content_for(:affected_areas) { @concern.affected_areas&.titleize } %>
</div>

  <%= render "wizard/weakness" %>

<% 
  groups = { 
    "Elbow" => ["elbow flexors", "elbow extensors"],
    "Forearm" => ["forearm supinators"],
    "Wrist" => ["wrist flexors", "wrist extensors", "wrist ulnar deviators"],
    "Fingers" => ["thumb extensors", "thumb adductors", "finger abductors", "finger adductors"]
  } 
%>

<%= render layout: 'step_frame', locals: { field_name: 'weakness' } do %>
  <% groups.each do |group_name, areas| %>
    <div class="list-group-item bg-light text-muted fw-bold small text-uppercase py-2">
      <%= group_name %>
    </div>
    <% areas.each do |area| %>
      <label class="list-group-item list-group-item-action d-flex align-items-center py-3 ps-4" for="check_<%= area.parameterize %>">
        <%= check_box_tag "concern[weakness][]", area, @concern.weakness.include?(area),
            class: "form-check-input me-3 weakness-checkbox", id: "check_#{area.parameterize}" %>
        <span><%= area.titleize %></span>
      </label>
    <% end %>
  <% end %>
<% end %>