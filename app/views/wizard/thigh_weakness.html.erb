<div>
  <% content_for(:affected_areas) { @concern.affected_areas&.titleize } %>
</div>

  <%= render "wizard/weakness" %>

<%# app/views/wizard/thigh_weakness.html.erb %>
<% 
  groups = {
    "Thigh" => ["hip flexors", "hip extensors", "hip adductors", "hip abductors"],
    "Knee"  => ["knee extensors", "knee flexors"],
    "Ankle" => ["ankle dorsiflexors", "ankle plantarflexors", "ankle everters"],
    "Toes"  => ["big toe extensors"]
  } 
%>

<%= render layout: 'step_frame', locals: { field_name: 'weakness' } do %>
  <% groups.each do |group_name, areas| %>
    <div class="list-group-item bg-light text-muted fw-bold small text-uppercase py-2">
      <%= group_name %>
    </div>
    
    <% areas.each do |area| %>
      <label class="list-group-item list-group-item-action d-flex align-items-center py-3 ps-4" for="check_<%= area.parameterize %>">
        <%= check_box_tag "concern[weakness][]", 
                          area, 
                          @concern.weakness.include?(area),
                          class: "form-check-input me-3 weakness-checkbox", 
                          id: "check_#{area.parameterize}" %>
        <span><%= area.titleize %></span>
      </label>
    <% end %>
  <% end %>
<% end %>