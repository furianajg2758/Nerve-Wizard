<!DOCTYPE html>
<html class="h-100">
  <head>
    <title><%= content_for(:title) || "Nerve Wizard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light d-flex flex-column min-vh-100">
    
    <header class="pt-4">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-md-8 col-lg-6">
            <%= render 'wizard/progress_bar' %>
          </div>
        </div>
      </div>
    </header>

    <main class="container py-4">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
          <div class="card shadow-sm p-4">
            <%= yield %>
          </div>
        </div>
      </div>
    </main>

    <footer class="footer mt-auto py-5 bg-light border-top">
      <div class="container">
        <div class="row justify-content-center text-center">
          <%# Narrowed the column width here to limit text width %>
          <div class="col-md-8 col-lg-6">
            
            <div class="disclaimer-box mb-4">
              <p class="text-muted small mb-3">
                <strong>Medical Disclaimer:</strong> This tool is for educational and informational purposes only. It is not intended to provide a medical diagnosis, nor does it replace the professional judgment of a healthcare provider. 
              </p>
              <p class="text-muted small">
                If you are experiencing a medical emergency or severe neurological symptoms (such as sudden weakness or loss of bowel/bladder control), please seek immediate emergency care.
              </p>
            </div>

            <div class="meta-info text-muted pt-3 border-top" style="font-size: 0.75rem; letter-spacing: 0.03rem;">
              <span><%= link_to "References & Citations", sources_path, class: "text-decoration-none text-muted fw-bold" %></span>
              <span class="mx-2">&bull;</span>
              <span>Last Clinical Review: March 2026</span>
              <br>
              <span class="mt-2 d-inline-block">&copy; <%= Time.now.year %> Nerve Wizard</span>
            </div>

          </div>
        </div>
      </div>
    </footer>

  </body>
</html>